  <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div> -->

  <div class="reveal mx-auto max-w-(--breakpoint-site) px-4 sm:px-6 mb-8 text-center sm:text-left">
    <h2 class="text-3xl sm:text-4xl font-display font-bold text-[var(--amarelo-destaque)] mt-3">
      Áreas de atuação
    </h2>
  </div>

  <!-- Carrosel / Marquee Infinito -->
  <AtuacaoMarquee client:visible />
