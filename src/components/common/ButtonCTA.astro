---
const {
  text = 'APOIAR',
  href = '#planos',
  variant = 'bg-[var(--amarelo-destaque)] text-lg',
  showHeartIcon = false,
  class: className = '',
  target = '_self',
} = Astro.props;

const selectedVariant = variant || 'bg-[var(--amarelo-destaque)]';
---

<a
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  class={`group inline-flex items-center text-black justify-center gap-2 font-bold px-6 py-2.5 rounded-2xl shadow-lg transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer shrink-0 ${selectedVariant} ${className}`}
>
  <span>{text}</span>

  {showHeartIcon && (
    <svg
      class={`w-4 h-4 transition-transform duration-200 group-hover:scale-110 ${
        variant === 'blue' ? 'fill-amber-400' : 'fill-blue-700'
      }`}
      viewBox="0 0 24 24"
    >
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
    </svg>
  )}
</a>