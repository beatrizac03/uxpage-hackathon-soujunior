---
import TextFadeThrough from './TextFadeThrough.jsx';
import ButtonCTA from '../common/ButtonCTA.jsx';

// Frases que vão alternar no Fade Through
const frasesDestaque = [
  "moldando o mercado de tecnologia",
  "criando novos futuros",
  "gerando impacto social",
  "acelerando carreiras tech"
];
---

<section id="banner" class="w-full bg-[#081252] text-white py-12 px-6 sm:px-10">
  <div class="mx-auto max-w-(--breakpoint-site) flex flex-col md:flex-row items-center justify-between gap-8">
    
    <!-- Lado Esquerdo: Frase com a Instância do TextFadeThrough -->
    <div class="reveal text-2xl sm:text-3xl lg:text-4xl font-display font-medium leading-snug max-w-2xl text-center md:text-left">
      <span>Juntos, nós estamos</span>
      <br class="hidden sm:inline" />
      
      <!-- Instância do componente React animado -->
      <TextFadeThrough 
        client:visible 
        words={frasesDestaque} 
        interval={3500} 
        className="bg-[image:var(--gradient-4)] bg-clip-text text-transparent font-bold" 
      />
    </div>

    <!-- Lado Direito: Chamada para Ação e Botão -->
    <div class="reveal flex flex-col items-center md:items-end gap-3 shrink-0">
      <span class="text-xs sm:text-lg text-slate-200 font-sans">
        Seja um apoiador da SouJunior a partir de R$ 2 mensais!
      </span>

      <ButtonCTA 
        text="APOIAR" 
        href="https://apoia.se/soujunior" 
        showHeartIcon={true}
        target="_blank"
        className="px-8 py-3 text-black bg-[var(--amarelo-destaque)]"
        />
    </div>

  </div>
</section>