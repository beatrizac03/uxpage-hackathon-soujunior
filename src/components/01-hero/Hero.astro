---
// src/components/01-hero/Hero.astro
import { Image } from 'astro:assets';
import ButtonCTA from '../common/ButtonCTA.jsx';
---

<section class="py-16 md:py-24 bg-(image:--gradient-1) max-md:pt-[110px] min-h-[90vh] overflow-hidden flex items-center relative" id="hero">
  <!-- Contêiner centralizado -->
  <div class="mx-auto max-w-(--breakpoint-site) px-4 sm:px-6 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      
      <!-- Lado Esquerdo: Texto -->
      <div class="flex flex-col gap-6 z-10">
        <h1 class="reveal text-[40px] md:text-[60px] font-bold tracking-tight text-(--amarelo-destaque) font-funnel-display leading-tight">
        Você transforma oportunidade em experiência real
      </h1>
        <p class="reveal text-lg text-(--branco)">
          Existimos para impulsionar a carreira de diversos profissionais iniciantes em tecnologia. Faça parte dessa transformação com doações a partir de R$ 2,00. 
        </p>
        
        <!-- Botão Apoiador Destacado (Desktop) -->
        <ButtonCTA 
          client:visible 
          text="APOIAR A PARTIR DE R$2" 
          href="https://apoia.se/soujunior" 
          showHeartIcon={true}
          target="_blank"
          className="mt-5 lg:w-[80%]"
        />

      </div>

      <!-- Lado Direito: Container com o bichinho ampliado -->
      <div class="reveal flex justify-center items-center min-h-[450px] sm:min-h-[550px] lg:min-h-[600px] relative w-full">
        <!-- Mantemos a largura base do container idêntica à original -->
        <div class="relative w-full max-w-[650px] flex items-center justify-center">
          
          <!-- Forma Amarela intocada (z-0 fica garantidamente atrás) -->
          <div 
            id="hero-yellow-shape" 
            class="absolute w-[320px] h-[320px] sm:w-[440px] sm:h-[440px] lg:w-[500px] lg:h-[500px] rounded-[120px] sm:rounded-[160px] lg:rounded-[200px] bg-(--amarelo-destaque) opacity-90 transition-transform duration-75 ease-out will-change-transform z-0 pointer-events-none"
          ></div>

          <!-- Contêiner do Mascote com z-10 para ficar na frente do amarelo -->
          <div class="w-full h-auto relative z-10 flex items-center justify-center">
            
            <!-- Imagem Estática Fallback (Visível APENAS no iPhone / Mobile) -->
            <img
              src="/hero_avatar_preview.png"
              alt="Mascote SouJunior"
              class="block md:hidden w-[75%] max-w-[300px] h-auto object-contain"
            />

            <!-- Vídeo WebM Original (Visível APENAS no Desktop / PC) -->
            <video
              autoplay
              loop
              muted
              playsinline
              class="hidden md:block w-full h-auto scale-125 lg:scale-140"
            >
              <source src="/hero_avatar.webm" type="video/webm" />
            </video>

          </div>
          
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Animação de expansão da forma amarela até ao final da dobra
  const heroSection = document.getElementById('hero');
  const yellowShape = document.getElementById('hero-yellow-shape');

  if (heroSection && yellowShape) {
    let ticking = false;

    const handleScroll = () => {
      const rect = heroSection.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // Calcula a percentagem percorrida do scroll dentro da secção Hero
      if (rect.bottom >= 0 && rect.top <= windowHeight) {
        const scrollProgress = Math.min(1, Math.max(0, -rect.top / (rect.height - windowHeight * 0.3)));
        
        // Aumenta a escala até 1.8x no final da dobra
        const scale = 1 + scrollProgress * 0.8; 
        const rotate = scrollProgress * 12;

        yellowShape.style.transform = `scale(${scale}) rotate(${rotate}deg)`;
      }

      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(handleScroll);
        ticking = true;
      }
    }, { passive: true });
  }
</script>