---
// src/components/02-metricas/Metricas.astro
import CountUp from './CountUp.jsx';
---

<!-- Wrapper suspenso com margem negativa -->
<div id="metricas" class="absolute z-30 -mt-16 md:-mt-24 px-4 sm:px-6 w-full">
  <!-- Container centralizado (1140px) -->
  <div class="mx-auto max-w-(--breakpoint-site)">
    
    <!-- Pílula de Métricas com Glassmorphism e Sombra Profunda -->
    <div 
      class="w-full rounded-3xl md:rounded-[32px] p-6 sm:p-8 bg-blue-950/80 backdrop-blur-xl border border-white/20 shadow-2xl shadow-blue-950/50 text-white"
    >
      <!-- Grid responsiva com divisórias -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 lg:divide-x divide-white/15 text-center">
        
        <!-- Metric 1 -->
        <div class="reveal flex flex-col items-center justify-center p-4 sm:p-6">
          <div class="font-display text-4xl sm:text-5xl font-bold text-white tracking-tight">
            <CountUp
              client:load
              from={0}
              to={120}
              duration={2}
            />
          </div>
          <p class="text-sm md:text-base text-blue-100 font-medium mt-2">
            membros
          </p>
        </div>

        <!-- Metric 2 -->
        <div class="reveal flex flex-col items-center justify-center p-4 sm:p-6">
          <div class="font-display text-4xl sm:text-5xl font-bold text-white tracking-tight flex items-center justify-center">
            <span>+</span>
            <CountUp
              client:load
              from={0}
              to={50}
              duration={2}
            />
          </div>
          <p class="text-sm md:text-base text-blue-100 font-medium mt-2">
            profissionais inseridos no mercado de trabalho
          </p>
        </div>

        <!-- Metric 3 -->
        <div class="reveal flex flex-col items-center justify-center p-4 sm:p-6">
          <div class="font-display text-4xl sm:text-5xl font-bold text-white tracking-tight">
            <CountUp
              client:load
              from={0}
              to={35}
              duration={2}
            />
          </div>
          <p class="text-sm md:text-base text-blue-100 font-medium mt-2">
            mentores ativos
          </p>
        </div>

        <!-- Metric 4 -->
        <div class="reveal flex flex-col items-center justify-center p-4 sm:p-6">
          <div class="font-display text-4xl sm:text-5xl font-bold text-white tracking-tight flex items-center justify-center gap-1.5">
            <CountUp
              client:load
              from={0}
              to={4}
              duration={1.5}
            />
            <span>  </span>
          </div>
          <p class="text-sm md:text-base text-blue-100 font-medium mt-2">
            anos de história
          </p>
        </div>

      </div>
    </div>

  </div>
</div>