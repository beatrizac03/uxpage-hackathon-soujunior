---
// src/components/CardsCarrossel.astro

const cardsData = [
  {
    main: "SouJunior Labs",
    sub: "Focado em projetos práticos em grupo. Funciona via Discord.",
    image: "/labs.webp",
  },
  {
    main: "SouJunior",
    sub: "Site institucional, feito pela comunidade. ",
    image: "/soujunior.webp",
  },
  {
    main: "SouJunior Talk",
    sub: "Para aprender inglês em comunidade. Funciona via Discord.",
    image: "/talk.webp",
  },
];
---

<section class="reveal cards-section py-12 md:py-20 w-full flex justify-center items-center">
  <div class="cards-container">
    {cardsData.map((card) => (
      <div class="card">
        <div class="header">
          <div class="header-text">
            <span class="text-main">{card.main}</span>
            <span class="text-sub">{card.sub}</span>
          </div>
          <button type="button" class="header-icon-btn" aria-label="Favoritar">
            <i class="fa-solid fa-heart"></i>
          </button>
        </div>
        
        <!-- Mantendo a tag <img> com lazy loading otimizado para a pasta public -->
        <img 
          class="avatar-img" 
          src={card.image} 
          alt={card.main} 
          loading="lazy"
          decoding="async"
        />
      </div>
    ))}
  </div>
</section>

<style>
  :root {
    --card-bg: #ffffff;
    --roxo: #1e1b4b;

    --scale-level-1: 1.2; 
    --scale-level-2: 0.98; 

    --active-scale: 1.35;
    --active-position-y: -2rem;

    --not-active-scale-offset: 0.1;
  }

  .cards-section {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .cards-container {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    width: 100%;
    max-width: 1100px;
    min-height: 520px;
  }

  .cards-container .card {
    display: flex;
    flex-direction: column;
    width: 330px;
    padding: 2rem 2rem 0 2rem;
    border-radius: 2.2vw;
    cursor: pointer;
    overflow: hidden;
    position: absolute;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    background-color: var(--card-bg);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .cards-container .card .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .cards-container .card .header .header-text .text-main {
    display: block;
    font-family: 'Funnel Display', sans-serif;
    font-weight: 700;
    font-size: 1.65rem;
    color: var(--roxo);
  }

  .cards-container .card .header .header-text .text-sub {
    display: block;
    font-family: 'Funnel Sans', sans-serif;
    font-weight: 400;
    font-size: 0.95rem;
    margin-top: 0.4rem;
    color: #555555;
    line-height: 1.4;
  }

  .cards-container .card .header .header-icon-btn {
    border: none;
    padding: 0;
    background-color: #f1f1f1;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    outline: 1px dashed transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: transform 0.3s, outline 0.3s;
  }

  .cards-container .card .header .header-icon-btn:before {
    content: "";
    position: absolute;
    background-color: #ffb6c1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    transform: scale(0);
    transition: transform 0.3s;
  }

  .cards-container .card .header .header-icon-btn i {
    position: relative;
    font-size: 1.15rem;
    color: #666;
    transition: color 0.3s;
  }

  .cards-container .card .header .header-icon-btn:hover:before {
    transform: scale(1);
  }

  .cards-container .card .header .header-icon-btn:hover i {
    color: #ff1493;
  }

  .cards-container .card .header .header-icon-btn:active {
    transform: translateY(2px);
    outline-color: #ff69b4;
  }

  .cards-container .card .avatar-img {
    align-self: center;
    flex-grow: 1;
    width: 100%;
    max-height: 210px;
    object-fit: contain;
    margin-top: 1.2rem;
    pointer-events: none;
  }

  .cards-container .card:before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: #000;
    left: 0;
    top: 0;
    border-radius: 2.2vw;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
    z-index: 2;
  }

  /* 1º Cartão (Esquerda) */
  .cards-container .card:nth-child(1) {
    transform: scale(var(--scale-level-2)) rotate(-15deg) translateX(-11.5rem) translateY(1.5rem);
    z-index: 5;
  }
  .cards-container .card:nth-child(1).active {
    transform: scale(var(--active-scale)) rotate(0deg) translateX(0) translateY(var(--active-position-y));
    z-index: 20;
  }
  .cards-container .card:nth-child(1).not-active {
    transform: scale(calc(var(--scale-level-2) - var(--not-active-scale-offset))) rotate(-15deg) translateX(-11.5rem) translateY(1.5rem);
  }

  /* 2º Cartão (Centro - Foco Principal) */
  .cards-container .card:nth-child(2) {
    transform: scale(var(--scale-level-1)) rotate(0deg) translateX(0) translateY(0);
    z-index: 10;
  }
  .cards-container .card:nth-child(2).active {
    transform: scale(var(--active-scale)) rotate(0deg) translateX(0) translateY(var(--active-position-y));
    z-index: 20;
  }
  .cards-container .card:nth-child(2).not-active {
    transform: scale(calc(var(--scale-level-1) - var(--not-active-scale-offset))) rotate(0deg) translateX(0) translateY(0);
  }

  /* 3º Cartão (Direita) */
  .cards-container .card:nth-child(3) {
    transform: scale(var(--scale-level-2)) rotate(15deg) translateX(11.5rem) translateY(1.5rem);
    z-index: 5;
  }
  .cards-container .card:nth-child(3).active {
    transform: scale(var(--active-scale)) rotate(0deg) translateX(0) translateY(var(--active-position-y));
    z-index: 20;
  }
  .cards-container .card:nth-child(3).not-active {
    transform: scale(calc(var(--scale-level-2) - var(--not-active-scale-offset))) rotate(15deg) translateX(11.5rem) translateY(1.5rem);
  }

  .cards-container .card.not-active:before {
    opacity: 0.25;
    visibility: visible;
  }

  @media (max-width: 768px) {
    .cards-container {
      max-width: 100%;
      min-height: 400px;
    }
    .cards-container .card {
      width: 260px;
      padding: 1.2rem;
    }
    .cards-container .card:nth-child(1) {
      transform: scale(0.85) rotate(-12deg) translateX(-5.5rem) translateY(1rem);
    }
    .cards-container .card:nth-child(3) {
      transform: scale(0.85) rotate(12deg) translateX(5.5rem) translateY(1rem);
    }
  }
</style>

<script>
  const cards = document.querySelectorAll(".cards-container .card");

  cards.forEach((card) => {
    card.addEventListener("mouseenter", () => {
      cards.forEach((c) => {
        if (c == card) c.classList.add("active");
        else c.classList.add("not-active");
      });
    });

    card.addEventListener("mouseleave", () => {
      cards.forEach((c) => {
        c.classList.remove("active", "not-active");
      });
    });

    card.addEventListener("touchstart", () => {
      cards.forEach((c) => {
        if (c == card) {
          if (c.classList.contains("active")) {
            c.classList.remove("active");
            cards.forEach((other) => other.classList.remove("not-active"));
          } else {
            c.classList.add("active");
            c.classList.remove("not-active");
          }
        } else {
          c.classList.add("not-active");
          c.classList.remove("active");
        }
      });
    }, { passive: true });
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest(".card")) {
      cards.forEach((c) => {
        c.classList.remove("active", "not-active");
      });
    }
  });
</script>