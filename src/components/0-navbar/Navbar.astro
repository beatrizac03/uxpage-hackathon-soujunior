---
// src/components/0-navbar/Navbar.astro
import { Image } from 'astro:assets';
import ButtonCTA from '../common/ButtonCTA.astro';

const navLinks = [
  { texto: "início", url: "#hero" },
  { texto: "causa", url: "#causa" },
  { texto: "projetos", url: "#projetos" },
  { texto: "planos", url: "#planos" },
];
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4 px-4 sm:px-6">
  <div class="mx-auto max-w-(--breakpoint-site) flex items-center justify-between gap-4 sm:gap-8">
    
    <!-- Pílula Glassmorphism Principal -->
    <nav id="glass-pill" class="w-full flex items-center justify-between px-6 sm:px-8 py-3 rounded-full bg-white/10 backdrop-blur-md border border-white/20 shadow-lg shadow-black/5 transition-all duration-300">
      
      <!-- Logo SouJunior -->
      <a href="https://www.soujunior.tech/" class="flex items-center gap-2.5 shrink-0 group">
        <Image 
          src="/logo-soujunior.svg" 
          alt="Logo SouJunior" 
          width={130} 
          height={45} 
          loading="eager"
          fetchpriority="high"
          class="w-[120px] sm:w-[150px] h-auto transition-transform duration-300 group-hover:scale-110" 
        />
      </a>

      <!-- Links de Navegação Desktop (Centralizados e com maior espaçamento) -->
      <div class="hidden md:flex items-center justify-center flex-1 px-8 gap-12">
        {navLinks.map((item) => (
          <a
            href={item.url}
            class="text-lg font-semibold text-white/90 hover:text-white hover:scale-105 transition-all duration-200 lowercase tracking-wide"
          > 
            {item.texto}
          </a>
        ))}
      </div>

      <!-- Botão Hambúrguer para Mobile -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-white p-1 rounded-lg focus:outline-none shrink-0"
        aria-label="Abrir menu"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </nav>

    <!-- Botão Apoiador Destacado (Apenas Desktop na Navbar - com gap maior) -->
    <div id="desktop-cta" class="hidden md:block shrink-0 ml-4 lg:ml-6">
      <ButtonCTA
        text="APOIAR" 
        href="https://apoia.se/soujunior" 
        showHeartIcon={true}
        target="_blank"
      />
    </div>

  </div>

  <!-- Menu Mobile Desdobrável (Drawer Glass) -->
  <div
    id="mobile-menu"
    class="hidden md:hidden mx-auto max-w-(--breakpoint-site) mt-3 p-6 rounded-3xl bg-slate-900/90 backdrop-blur-xl border border-white/10 shadow-2xl flex-col gap-4 text-center"
  >
    {navLinks.map((item) => (
      <a
        href={item.url}
        class="mobile-link text-lg font-medium text-white/90 hover:text-amber-400 py-2 border-b border-white/5 lowercase"
      >
        {item.texto}
      </a>
    ))}

    <div class="mt-2 flex justify-center">
      <ButtonCTA
        text="APOIAR" 
        href="https://apoia.se/soujunior" 
        showHeartIcon={true}
        target="_blank"
      />
    </div>
  </div>
</header>

<!-- Botão CTA Flutuante Fixo instanciado com o componente <ButtonCTA> -->
<div id="floating-cta" class="fixed bottom-6 right-6 z-40 translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
  <div class="pointer-events-auto shadow-2xl rounded-full">
    <ButtonCTA
      text="APOIAR" 
      href="https://apoia.se/soujunior" 
      showHeartIcon={true}
      target="_blank"
    />
  </div>
</div>

<script>
  const header = document.getElementById('main-header');
  const glassPill = document.getElementById('glass-pill');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  const floatingCta = document.getElementById('floating-cta');
  const planosSection = document.getElementById('planos');

  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;

    if (scrollY > 40) {
      header?.classList.add('py-2');
      header?.classList.remove('py-4');
      glassPill?.classList.add('bg-slate-950/60', 'border-white/30', 'shadow-xl');
      glassPill?.classList.remove('bg-white/10');
    } else {
      header?.classList.add('py-4');
      header?.classList.remove('py-2');
      glassPill?.classList.add('bg-white/10');
      glassPill?.classList.remove('bg-slate-950/60', 'border-white/30', 'shadow-xl');
    }

    let hideNearPlanos = false;
    if (planosSection) {
      const rect = planosSection.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom >= 0) {
        hideNearPlanos = true;
      }
    }

    if (scrollY > 300 && !hideNearPlanos) {
      floatingCta?.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
    } else {
      floatingCta?.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
    }
  });

  menuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');

    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    } else {
      mobileMenu?.classList.remove('hidden');
      mobileMenu?.classList.add('flex');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>