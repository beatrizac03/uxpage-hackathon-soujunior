---
// src/components/sections/Planos.astro

import ButtonCTA from '../common/ButtonCTA.jsx';

const planosData = [
  { 
    titulo: "Apoiador iniciante",
    valorMin: "2,00",
    valorMax: "4,00",
    descricao: "Faça parte da nossa comunidade e acompanhe os projetos da SouJunior.",
    beneficios: [
      "Acesso ao grupo para conhecer os projetos",
      "Acompanhe os projetos da SouJunior de perto",
      "Ajuda a manter a iniciativa 100% gratuita para novos talentos."
    ],
    link: "#apoiar-iniciante"
  },
  {
    titulo: "Apoiador da Jornada",
    valorMin: "5,00",
    valorMax: "8,00",
    descricao: "Fortaleça a jornada de quem está começando na tecnologia e receba o Guia iniciante em TI.",
    beneficios: [
      "Guia Iniciante em TI (construído pelo fundador Wouerner Brandão).",
      "Acesso ao Grupo",
      "Acompanhe os projetos em desenvolvimento"
    ],
    link: "#apoiar-jornada"
  }
];
---

<section id="planos" class="py-16 md:py-24 bg-slate-50 text-slate-900">
  <div class="mx-auto max-w-(--breakpoint-site) px-4 sm:px-6 flex flex-col items-center">
    
    <!-- Cabeçalho da Seção -->
    <div class="text-center max-w-2xl mb-12">
      <span class="reveal text-xs sm:text-sm font-semibold uppercase tracking-wider text-blue-600 underline underline-offset-8 decoration-blue-400">
        Planos
      </span>
      <h2 class="reveal text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-blue-950 mt-4 leading-tight">
        Escolha como apoiar a SouJunior
      </h2>
      <p class="reveal text-base sm:text-lg text-slate-600 font-sans mt-4 leading-relaxed">
        Seu apoio ajuda a viabilizar ferramentas e estrutura para que iniciantes construam experiência real em tecnologia.
      </p>
    </div>

    <!-- Grid dos Cards de Planos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full max-w-4xl">
      {planosData.map((plano) => (
        <div class="reveal-left bg-gradient-to-br from-blue-900 via-blue-950 to-slate-950 text-white rounded-3xl p-8 sm:p-10 shadow-2xl flex flex-col justify-between border border-blue-800/50 transition-transform duration-300 hover:-translate-y-1">
          
          <div>
            <!-- Título do Plano -->
            <h3 class="text-xl sm:text-2xl font-bold font-display flex items-center gap-2 text-amber-400">
              <span>{plano.titulo}</span>
            </h3>

            <!-- Valor/Preço -->
            <div class="my-6 flex items-baseline gap-1">
              <span class="text-xs font-bold text-blue-300 self-start mt-2">R$</span>
              <span class="text-4xl sm:text-5xl font-black font-display text-white tracking-tight">
                {plano.valorMin}
              </span>
              <span class="text-xl font-bold text-blue-300 mx-1">a</span>
              <span class="text-4xl sm:text-5xl font-black font-display text-white tracking-tight">
                {plano.valorMax}
              </span>
              <span class="text-xs font-semibold text-blue-300 ml-1">/mês</span>
            </div>

            <!-- Descrição Curta -->
            <p class="text-sm font-medium text-blue-100 leading-relaxed">
              {plano.descricao}
            </p>

            <!-- Lista de Benefícios -->
            <div class="mt-8">
              <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-4">
                Benefícios:
              </h4>
              <ul class="space-y-3">
                {plano.beneficios.map((item) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm font-medium text-slate-200 leading-snug">
                    <span class="shrink-0 text-emerald-400 mt-0.5">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
                      </svg>
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Botão de Ação -->
          <ButtonCTA 
            client:visible 
            text="Seja um apoiador" 
            href="https://apoia.se/soujunior" 
            showHeartIcon={true}
            target="_blank"
            className="mt-5 lg:w-[80%] bg-[var(--amarelo-destaque)] text-slate-950 font-bold hover:bg-white m-auto transition-colors"
          />

        </div>
      ))}
    </div>

  </div>
</section>