---
// src/components/sections/Impacto.astro
import TrilhaCarreira from './TrilhaCarreira.jsx';
import Scanner from '../common/Scanner.jsx';
---

<section id="impacto" class="py-24 lg:py-32 text-slate-900 overflow-hidden relative min-h-[85vh] flex items-center bg-slate-50">

  {/* Conteúdo Principal */}
  <div class="mx-auto max-w-(--breakpoint-site) px-4 sm:px-6 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      {/* Coluna da Esquerda: Textos */}
      <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
        <h2 class="reveal-left text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-blue-950 leading-tight text-balance">
          Do aprendizado à primeira oportunidade real
        </h2>

        <p class="reveal-left text-base sm:text-lg text-slate-700 leading-relaxed font-sans">
          Cada apoio financia a estrutura que sustenta esse caminho: mentoria ativa, projetos reais e uma comunidade que aprende fazendo, junta.
        </p>
      </div>

      {/* Coluna da Direita: Trilha Interativa sem overflow estourado */}
      <div class="reveal-right lg:col-span-6 flex justify-center items-center w-full py-4">
        <div class="w-full max-w-[600px] px-2">
          <TrilhaCarreira client:visible />
        </div>
      </div>

    </div>
  </div>

</section>